
import pandas as pd

def validate_sales(file_path):
    df = pd.read_csv(file_path)

    # Example checks
    assert not df.isnull().values.any(), "Data contains null values"
    assert 'Revenue' in df.columns, "Revenue column missing"
    assert df['Revenue'].min() >= 0, "Negative revenue detected"

    print("Validation passed!")

if __name__ == "__main__":
    validate_sales("../data/sample_pos.csv")
